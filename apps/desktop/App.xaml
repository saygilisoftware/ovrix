<Application x:Class="Ovrix.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Base" Color="#090E13"/>
        <SolidColorBrush x:Key="Panel" Color="#101820"/>
        <SolidColorBrush x:Key="Surface" Color="#17232D"/>
        <SolidColorBrush x:Key="Stroke" Color="#273745"/>
        <SolidColorBrush x:Key="Text" Color="#F0F7FA"/>
        <SolidColorBrush x:Key="Muted" Color="#9DB1C1"/>
        <SolidColorBrush x:Key="Accent" Color="#70F5D9"/>
        <SolidColorBrush x:Key="Selected" Color="#142A2D"/>
        <Geometry x:Key="BrandRing">F0 M 16,0 L 28,0 34,6 20,20 14,20 26,8 24,6 17,6 6,17 6,24 8,26 15,26 20,21 27,21 16,32 5,32 0,27 0,15 Z</Geometry>
        <Geometry x:Key="BrandCut">M 30,10 L 34,6 34,17 29,22 22,22 28,16 28,12 Z</Geometry>
        <Geometry x:Key="Nav0">M 2,2 H 9 V 9 H 2 Z M 13,2 H 20 V 9 H 13 Z M 2,13 H 9 V 20 H 2 Z M 13,13 H 20 V 20 H 13 Z</Geometry>
        <Geometry x:Key="Nav1">M 2,4 H 20 V 16 H 2 Z M 8,20 H 14 M 11,16 V 20 M 9,8 L 9,12 14,10 Z</Geometry>
        <Geometry x:Key="Nav2">M 4,16 L 12,3 11,10 18,10 10,21 11,14 Z</Geometry>
        <Geometry x:Key="Nav3">M 3,4 H 19 V 15 H 10 L 6,19 V 15 H 3 Z M 6,8 H 15 M 6,11 H 12</Geometry>
        <Geometry x:Key="Nav4">M 7,6 H 15 Q 18,6 19,9 L 21,15 Q 21,20 17,16 L 15,14 H 7 L 5,16 Q 1,20 1,15 L 3,9 Q 4,6 7,6 Z M 5,10 H 9 M 7,8 V 12 M 15,9 L 15.2,9 M 17,11 L 17.2,11</Geometry>
        <Geometry x:Key="Nav5">M 3,8 H 19 V 19 H 3 Z M 5,4 H 17 M 8,12 H 14</Geometry>
        <Geometry x:Key="Nav6">M 1,12 H 5 L 8,5 12,18 15,10 17,12 H 21</Geometry>
        <Geometry x:Key="Nav7">M 11,2 L 14,4 17,4 17,7 20,10 18,13 18,17 14,17 11,20 8,17 4,17 4,13 2,10 5,7 5,4 8,4 Z M 11,7 A 4,4 0 1 0 11,15 A 4,4 0 1 0 11,7</Geometry>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Control" x:Key="Field">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource Field}"/>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource Field}"/>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="9,0,0,0"/>
            <Setter Property="Margin" Value="0,3,0,12"/>
            <Setter Property="MinHeight" Value="23"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="33"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="Switch" Height="18" CornerRadius="9" Background="{StaticResource Surface}"
                                    BorderBrush="#3A4E5C" BorderThickness="1" VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Height="10" Width="10" Fill="{StaticResource Muted}"
                                         HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Switch" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Switch" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#10423F"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Switch" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Switch" Property="BorderBrush" Value="#F0F7FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" VerticalAlignment="Center" Height="21">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="#52BAAB"/></Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="17" Height="17" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource Accent}" Stroke="#142A2D" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="#304452"/></Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource Field}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value=".75"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value=".4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#071817"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="20,9"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource Field}">
            <Setter Property="MinHeight" Value="37"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="TriggerSurface" Background="{StaticResource Surface}"
                                                BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8">
                                            <Path Data="M 0,0 L 4,4 8,0" Stroke="{StaticResource Muted}" StrokeThickness="1.5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TriggerSurface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="TriggerSurface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="11,0,29,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}"
                                        BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".49"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Item" Property="Background" Value="{StaticResource Surface}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox" BasedOn="{StaticResource Field}"/>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="5,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Item" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#20363D"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#27514F"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
